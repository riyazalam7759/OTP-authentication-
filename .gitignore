# Dependencies
node_modules/

# Environment files (often contain secrets like DB URL, JWT secret, SMTP password)
.env
.env.*
!.env.example
!.env.sample

# Secret and private key files
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks

# Local databases and dumps (can include real user data)
*.sqlite
*.sqlite3
*.db
*.sql
*.dump
*.bak

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# Test output / reports
coverage/
.nyc_output/

# Runtime and process temp files
pids/
*.pid
*.pid.lock

# Cache/temp folders
.cache/
tmp/
temp/

# User-generated uploaded files (avoid pushing private files)
uploads/

# App-specific sensitive config files (store secrets in .env instead)
middleware/Email.config.js
config/secrets.js
config/credentials.js

# Common secret/token files
.envrc
.npmrc
secrets.json
credentials.json
token.json
service-account*.json

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
